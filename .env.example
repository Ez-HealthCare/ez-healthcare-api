# Application
PORT=3000
NODE_ENV=development
JWT_ACCESS_SECRET=replace-with-a-random-secret-of-at-least-32-characters
CORS_ORIGINS=http://localhost:3001
# HMAC key for prescription signatures; replace for deployments.
SIGNATURE_SECRET=replace-with-a-random-prescription-signing-secret
# Mailpit-compatible send API. Production needs a configured mail relay.
OTP_DELIVERY_URL=http://localhost:8025/api/v1/send
OTP_FROM=no-reply@ezhealthcare.test
# Optional Authorization header for the mail send API.
OTP_DELIVERY_AUTH=
# Demo default: issue and keep queue tickets active for the whole local business day.
QUEUE_ISSUANCE_WINDOWS=00:00-24:00

# PostgreSQL Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=tlcn_api_db
DB_SYNC=false
DB_LOGGING=true

# Pilot. Service duration includes the time from call until the counter is released.
RECEPTION_ETA_ENABLED=false
RECEPTION_ETA_COUNTERS=2
RECEPTION_ETA_SERVICE_MINUTES=5

# Pilot assumptions for the sàng lọc station. Clinic uses the assigned doctor's slot duration.
DOWNSTREAM_ETA_ENABLED=false
TRIAGE_ETA_COUNTERS=2
TRIAGE_ETA_SERVICE_MINUTES=7
