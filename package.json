{
  "name": "api",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "type": "module",
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "deploy": "nest deploy",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"test/**/*.ts\"",
    "validate": "npm run format:check && npm run lint && npm test -- --runInBand && npm run build",
    "dev": "npm run start:dev",
    "start": "nest start --exec \"node --loader ./esm-loader.mjs\" --shell",
    "start:dev": "nest start --watch --exec \"node --loader ./esm-loader.mjs\" --shell",
    "start:debug": "nest start --debug --watch --exec \"node --loader ./esm-loader.mjs\" --shell",
    "start:prod": "node --loader ./esm-loader.mjs dist/main.js",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\"",
    "lint:fix": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "oxlint": "oxlint src/ test/",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "test:watch": "node --experimental-vm-modules node_modules/jest/bin/jest.js --watch",
    "test:cov": "node --experimental-vm-modules node_modules/jest/bin/jest.js --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "node --experimental-vm-modules node_modules/jest/bin/jest.js --config ./test/jest-e2e.json",
    "prepare": "husky",
    "typeorm": "node --loader ts-node/esm --experimental-specifier-resolution=node ./node_modules/typeorm/cli.js",
    "typeorm:cli": "node --loader ts-node/esm --experimental-specifier-resolution=node ./node_modules/typeorm/cli.js -d ./src/database/data-source.ts",
    "migration:create": "node --loader ts-node/esm --experimental-specifier-resolution=node ./node_modules/typeorm/cli.js migration:create",
    "migration:generate": "node --loader ts-node/esm --experimental-specifier-resolution=node ./node_modules/typeorm/cli.js -d ./src/database/data-source.ts migration:generate",
    "migration:run": "node --loader ts-node/esm --experimental-specifier-resolution=node ./node_modules/typeorm/cli.js -d ./src/database/data-source.ts migration:run",
    "migration:revert": "node --loader ts-node/esm --experimental-specifier-resolution=node ./node_modules/typeorm/cli.js -d ./src/database/data-source.ts migration:revert",
    "migration:show": "node --loader ts-node/esm --experimental-specifier-resolution=node ./node_modules/typeorm/cli.js -d ./src/database/data-source.ts migration:show"
  },
  "dependencies": {
    "@nestjs/common": "^12.1.3",
    "@nestjs/config": "^12.0.1",
    "@nestjs/core": "^12.1.3",
    "@nestjs/jwt": "^12.0.3",
    "@nestjs/observe": "^0.1.8",
    "@nestjs/passport": "^12.0.0",
    "@nestjs/platform-express": "^12.1.3",
    "@nestjs/swagger": "^12.0.2",
    "@nestjs/typeorm": "^12.0.2",
    "bcrypt": "^6.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "dotenv": "^17.4.2",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pg": "^8.23.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "typeorm": "^1.1.1"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@nestjs/cli": "^12.0.8",
    "@nestjs/mau": "^0.2.6",
    "@nestjs/schematics": "^12.0.7",
    "@nestjs/testing": "^12.1.3",
    "@types/bcrypt": "^6.0.0",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.0.0",
    "@types/passport-jwt": "^4.0.1",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.0.0",
    "@typescript-eslint/eslint-plugin": "^8.70.0",
    "@typescript-eslint/parser": "^8.70.0",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "jest": "^30.0.0",
    "lint-staged": "^17.5.1",
    "oxlint": "^1.58.0",
    "prettier": "^3.4.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.2"
  }
}
